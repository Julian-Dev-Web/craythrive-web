# Public browser configuration. Supply actual project values locally / in Vercel.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only; leave blank when using a publishable key.
VITE_SUPABASE_ANON_KEY=
# Optional canonical HTTPS site origin for password recovery.
VITE_APP_SITE_URL=

# Server ONLY, for the authenticated /api/tank-schema endpoint.
# Set in Vercel Environment Variables for the same project, then redeploy.
# Never prefix these with VITE_. Do not commit real values.
SUPABASE_SECRET_KEY=
# Legacy fallback only; leave blank when using a secret key.
SUPABASE_SERVICE_ROLE_KEY=
