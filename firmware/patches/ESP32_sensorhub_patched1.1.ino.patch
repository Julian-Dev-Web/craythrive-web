+// Synchronize display/upload cache with measurement health. This is not an
+// actuator decision: SENSOR_STALE carries a value only for display/history.
+void refreshCachedWaterHealth() {
+  waterReadingHealth.expire(millis());
+  if (waterReadingHealth.state == WaterHealthState::Fresh) return;
+  if (waterReadingHealth.state == WaterHealthState::Stale) {
+    cachedWaterLevelCM = lastGoodWaterDepthCM;
+    cachedRawWaterDistanceCM = lastGoodRawWaterDistanceCM;
+    cachedWaterStatus = "SENSOR_STALE";
+    cachedWaterAdvice = "Water-level measurement was temporarily unavailable. Showing the latest valid reading while waiting for a fresh measurement.";
+    hasWaterReading = true;
+    return;
+  }
+  cachedWaterLevelCM = -1;
+  cachedRawWaterDistanceCM = -1;
+  hasWaterReading = false;
+  if (waterReadingHealth.state == WaterHealthState::Waiting) {
+    cachedWaterStatus = "NO_READING";
+    cachedWaterAdvice = "Waiting for the first valid water-level measurement.";
+  } else {
+    cachedWaterStatus = "SENSOR_ERROR";
+    cachedWaterAdvice = "Water-level sensor failure confirmed. Waiting for a fresh valid measurement.";
+  }
+}
